# =============================================================================
# Environment Variables for MT5 Hedging Dashboard
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# =============================================================================
# Flask Configuration
# =============================================================================
FLASK_ENV=production
FLASK_SECRET_KEY=your-super-secret-key-change-this-in-production

# =============================================================================
# Database Configuration
# =============================================================================
# The app reads DATABASE_URL directly (see dashboard/database.py).
# For SQLite (local dev):
DATABASE_URL=sqlite:///dashboard/dashboard.db

# For PostgreSQL on PythonAnywhere (production) — replace values below:
# DATABASE_URL=postgresql://tradeopss_user:your-password@ballerquotes-5185.postgres.pythonanywhere-services.com:15185/tradeopss

# Research: production via SSH tunnel (PythonAnywhere — do not commit real passwords)
# PRODUCTION_USE_SSH_TUNNEL=true
# PRODUCTION_DB_HOST=ballerquotes-XXXX.postgres.pythonanywhere-services.com
# PRODUCTION_DB_PORT=15185
# PRODUCTION_DB_NAME=tradeopss
# PRODUCTION_DB_USER=tradeopss_admin
# PRODUCTION_DB_PASSWORD=
# SSH_TUNNEL_HOST=ssh.pythonanywhere.com
# SSH_TUNNEL_PORT=22
# SSH_TUNNEL_USER=ballerquotes
# SSH_TUNNEL_PASSWORD=

# ML Predictions page (super_admin) — ENABLED BY DEFAULT (no vars required).
# Lines below are OPTIONAL overrides; commented here only as documentation (.env.example
# is a template). Copy into your real .env only if you need to change a default.
#
# Defaults (code): ML_PREDICTIONS_ENABLED=true, cache=dashboard/instance/ml_cache/{local|production},
#   refresh=300s local / 120s on PythonAnywhere, one background worker on uWSGI (flock).
# Routing: local app → local DATABASE_URL; PythonAnywhere → production DATABASE_URL (auto).
# CLI production report from PC: .\scripts\run_ml_production.ps1 (not the dashboard page).
#
# ML_PREDICTIONS_ENABLED=false
# ML_REFRESH_INTERVAL_SEC=120
# ML_CACHE_DIR=/home/ballerquotes/MT5Dashboard/dashboard/instance/ml_cache
# ML_DEPLOYED_PRODUCTION=true
# ML_PREDICTIONS_LEADER=false
# mt5_timing on each push stores TimeCurrent-vs-Nairobi offset (identity.mt5_timing).
# On PythonAnywhere, ML refresh runs in a subprocess by default (keeps uWSGI workers responsive).
# ML_USE_SUBPROCESS=false
# ML_RF_N_JOBS=1
# ML_REFRESH_TIMEOUT_SEC=600

# =============================================================================
# Redis Configuration (for caching and rate limiting)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# Rate Limiting
# =============================================================================
# Use 'memory://' for development, Redis URL for production
RATELIMIT_STORAGE_URL=memory://

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# =============================================================================
# Gunicorn Configuration
# =============================================================================
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=sync
GUNICORN_LOG_LEVEL=info

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/dashboard.log

# =============================================================================
# Security
# =============================================================================
ADMIN_PASSWORD=BallerAdmin@123
BEF_ADMIN_PASSWORD=BEFAdmin@123

# =============================================================================
# Optional: Sentry Error Tracking
# =============================================================================
# SENTRY_DSN=https://your-sentry-dsn

# =============================================================================
# Optional: CORS Configuration
# =============================================================================
CORS_ORIGINS=*

# =============================================================================
# Slack Integration (Quality Reports)
# =============================================================================
# Create a Slack Incoming Webhook and paste the URL here
# SLACK_WEBHOOK_URL=your-slack-webhook-url-here
