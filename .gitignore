# Root ignores (repo-wide)

# Runtime logs
**/server.log
**/server_recent.log
**/*.log

# Python cache
**/__pycache__/
**/*.pyc

# Virtual environments
venv/
.venv/

# Local env/secrets
.env

# Local AI/human memory docs (keep out of git)
plan.md

# Local-only PDF helper + generated report output (not tracked)
_render_report_pdf.py
reports/

# Local ML package + dev tooling (not published to remote yet)
machine_learning/
requirements-ml.txt
notebooks/trade_ml_walkforward.ipynb
scripts/export_trades_for_ml.py

# ML artifacts (exported trades + trained models)
data/ml/*.parquet
data/ml/*.csv
data/ml/models/

# Local runtime state / data files
pg_backups/
config/hierarchy.json
dashboard/.scheduler_state.json
dashboard/instance/ml_cache/
trader_companion/trader_bias.json

# Local companion ML tuning / journals (machine-specific; do not commit)
trader_companion/signals/indicator_params_ustech_m5.json
trader_companion/signals/*.jsonl
scripts/_compare_matt_csv.py

local-before-restore.dump

# Local databases (large, contain real client data  never commit)
*.db
*.sqlite
*.sqlite3
dashboard/dashboard.db

# Downloaded production logs (may contain client/request data)
prod_logs/

# Local investigation exports (client data, one-off reports)
exports/

# Editor / agent state (machine-specific)
.claude/
.vscode/
.idea/

# Build / release artifacts (binaries, often hundreds of MB)
Releases/
build/
dist/
